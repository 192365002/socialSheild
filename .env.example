# SocialShield Backend Environment Variables Configuration
# Copy this file to .env and fill in your values

PORT=5000
JWT_SECRET=your_jwt_secret_key_here
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.yzalpdh.mongodb.net/?appName=Cluster0
FLASK_ENV=production
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Security & AI APIs
GOOGLE_SAFE_BROWSING_API_KEY=YOUR_GOOGLE_SAFE_BROWSING_KEY
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_KEY
HUGGINGFACE_API_KEY=YOUR_HUGGINGFACE_KEY
